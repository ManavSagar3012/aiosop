# AI-OSOP Agent Container
# Universal agent image that runs any agent type based on environment variable

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    gcc \
    libffi-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY src/ src/
COPY config/ config/

# Create non-root user for security
RUN useradd -m -u 1000 aiosop && chown -R aiosop:aiosop /app
USER aiosop

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import redis; r = redis.from_url('${REDIS_URL:-redis://localhost:6379}'); r.ping()" || exit 1

# Default command runs the agent specified by AGENT_TYPE environment variable
CMD ["sh", "-c", "python -m ai_osop.agents.run_agent --type ${AGENT_TYPE:-recon} --id ${AGENT_ID:-agent-01}"]
