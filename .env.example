# AI-OSOP Environment Configuration

# Infrastructure
OSOP_ENV=development
OSOP_LOG_LEVEL=INFO

# Database
OSOP_NEO4J_URI=bolt://localhost:7687
OSOP_NEO4J_USER=neo4j
OSOP_NEO4J_PASSWORD=change-me-local

OSOP_POSTGRES_URI=postgresql+asyncpg://osop:osop@localhost:5432/osop
OSOP_REDIS_URI=redis://localhost:6379/0

# LLM / AI
OSOP_LLM_PRIMARY=openai
OSOP_LLM_PRIMARY_MODEL=gpt-4o
OSOP_LLM_FALLBACK_MODEL=gpt-4o-mini
OSOP_LLM_KEY_PATH=secret/data/llm/openai
# Embedding model + dimension for semantic memory (P2 learning brain).
# The dimension MUST match the model output and the pgvector column width.
#   OpenAI text-embedding-3-small -> 1536 (default)
#   Ollama nomic-embed-text       -> 768   (local; `ollama pull nomic-embed-text`)
# Switching models requires a fresh vector table or a migration of the columns.
OSOP_LLM_EMBEDDING_MODEL=text-embedding-3-small
OSOP_LLM_EMBEDDING_DIM=1536

# Burp Suite
OSOP_BURP_MCP_HOST=localhost
OSOP_BURP_MCP_PORT=8081

# MCP Servers
OSOP_RECON_MCP_HOST=localhost
OSOP_RECON_MCP_PORT=8082
OSOP_PAYLOAD_MCP_HOST=localhost
OSOP_PAYLOAD_MCP_PORT=8083
OSOP_NUCLEI_MCP_HOST=localhost
OSOP_NUCLEI_MCP_PORT=8084
OSOP_SHODAN_MCP_HOST=localhost
OSOP_SHODAN_MCP_PORT=8085
OSOP_SHODAN_API_KEY=

# Security
OSOP_SANDBOX_RUNTIME=docker
