{
  "dashboard": {
    "title": "AI-OSOP Security",
    "tags": ["ai-osop", "security", "approvals", "rbac"],
    "timezone": "utc",
    "panels": [
      {
        "id": 1,
        "title": "Pending Approvals",
        "type": "stat",
        "targets": [
          {
            "expr": "ai_osop_pending_approvals",
            "legendFormat": "Pending"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Approval Decisions Over Time",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(ai_osop_approvals_total[5m])",
            "legendFormat": "{{decision}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}
      },
      {
        "id": 3,
        "title": "Approval Wait Time (p95)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(ai_osop_approval_wait_time_seconds_bucket[5m]))",
            "legendFormat": "p95"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}
      },
      {
        "id": 4,
        "title": "RBAC Failures",
        "type": "table",
        "targets": [
          {
            "expr": "rate(ai_osop_rbac_failures_total[5m])",
            "format": "table",
            "legendFormat": "{{endpoint}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}
      },
      {
        "id": 5,
        "title": "Scope Violations",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(ai_osop_scope_violations_total[5m])",
            "legendFormat": "{{rule}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}
      }
    ],
    "schemaVersion": 36,
    "version": 1
  }
}
