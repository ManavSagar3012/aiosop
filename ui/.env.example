# AI-OSOP Approval Console Environment Configuration

# Base URL for the FastAPI backend API
VITE_API_BASE=http://127.0.0.1:8200

# Base URL for the WebSocket stream
VITE_WS_BASE=ws://127.0.0.1:8200

# Security Bearer Token required for authentication
# Set this to match your backend API authorization token
VITE_OSOP_TOKEN=
