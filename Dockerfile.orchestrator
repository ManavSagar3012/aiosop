# AI-OSOP Orchestrator Container
# Main orchestration service with swarm coordination

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    gcc \
    libffi-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY src/ src/
COPY config/ config/
COPY mcp_servers/ mcp_servers/

# Create logs and reports directories
RUN mkdir -p /app/logs /app/reports

# Create non-root user for security
RUN useradd -m -u 1000 aiosop && chown -R aiosop:aiosop /app
USER aiosop

# Expose API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run the orchestrator with swarm support
CMD ["python", "-m", "ai_osop.orchestrator.main", "--enable-swarm"]
