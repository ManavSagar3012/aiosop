# k8s/secrets.yaml.example
#
# This is a TEMPLATE. Do NOT commit real secrets to version control.
# To deploy: copy to secrets.yaml, fill in base64-encoded values, then:
#   kubectl apply -f k8s/secrets.yaml
#
# To encode a value:
#   echo -n "your-value-here" | base64 -w0
#
# To decode (for verification):
#   echo "base64-encoded-value-here" | base64 -d
#
# In production, consider using:
#   - External Secrets Operator (ESO) with AWS Secrets Manager / GCP Secret Manager
#   - HashiCorp Vault agent injector
#   - Sealed Secrets (bitnami-labs/sealed-secrets)
---
apiVersion: v1
kind: Secret
metadata:
  name: ai-osop-secrets
  namespace: ai-osop
  labels:
    app: ai-osop
type: Opaque
data:
  # Database URIs (format: protocol://user:password@host:port/dbname)
  # Example: echo -n "bolt://neo4j:7687" | base64 -w0
  neo4j-uri: ""          # e.g., Ym9sdDovL25lbzRqOjc2ODc=
  neo4j-password: ""     # e.g., Y2hhbmdlLW1lLW5vdy1wbGVhc2U=
  postgres-uri: ""       # e.g., cG9zdGdyZXNxbCthc3luY3BnOi8vb3NvcDpvc29wQHBvc3RncmVzOjU0MzIvb3NvcA==
  redis-uri: ""          # e.g., cmVkaXM6Ly9yZWRpczo2Mzc5LzA=

  # API authentication
  api-token: ""          # e.g., bXktc2VjdXJlLWFwaS10b2tlbi0yMDI2

  # JWT configuration (optional, for JWT-based auth)
  jwt-secret: ""         # e.g., bXktand0LXNlY3JldC0yMDI2

---
# Note: In CI/CD pipelines, generate this manifest dynamically with
# actual base64 values from your secret store instead of editing this file.
